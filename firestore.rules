rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // one document per deck: { slide: int, locked: bool }
    match /decks/{deckId} {
      // anyone (students, no account) can read where the instructor is
      allow read: if true;
      // only the instructor's google account can change it
      // replace the address below with the google account you present from
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email in ['YOUR_GOOGLE_EMAIL@example.com']
                   && request.resource.data.keys().hasOnly(['slide', 'locked'])
                   && request.resource.data.slide is int
                   && request.resource.data.locked is bool;
    }
    // everything else stays closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
